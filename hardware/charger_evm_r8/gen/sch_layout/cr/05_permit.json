    110.49
   ],
   "size": 1.27
  },
  {
   "text": "H1U = H1 AND UVB   (U118A, regen release)",
   "at": [
    132.08,
    114.3
   ],
   "size": 1.27
  },
  {
   "text": "FCCP = FCC_ON AND FCCNN   (U118B, agreement term)",
