(version 1)
# 4-layer fab rules, OSH Park only (CR). LAYOUT_DECISIONS D-29 amended 2026-11-12;
# decisions_2026-11-12/stackup_fabrules_decisions_2026-11-12.md section 3 ("OSH Park-only (Recommended)").
# Source of every value: [OSH] https://docs.oshpark.com/services/four-layer/ (as read on 2026-11-10 for
# fab_4layer_oshpark_pcbway.kicad_dru). The PCBWay minima of that file drop out; a PCBWay order needs a re-check.
# Router net-class default is 0.1524 / 0.1524 mm (6/6 mil); 0.127 mm is the rule-file minimum, used at necks only.
# Vias: 0.6 / 0.3 mm is the only via on the CR (D-29); the rule minimum below is the fab limit, not the via size.

# Trace width. [OSH] 4-layer 5 mil (0.127 mm).
(rule "fab_track_width"
  (constraint track_width (min 0.127mm)))

# Copper-to-copper clearance. [OSH] 4-layer 5 mil (0.127 mm).
(rule "fab_clearance"
  (constraint clearance (min 0.127mm)))

# Copper-to-board-edge. [OSH] 15 mil (0.381 mm) from nominal board edge.
(rule "fab_edge_clearance"
  (constraint edge_clearance (min 0.381mm)))

# Minimum drill. [OSH] 10 mil (0.254 mm). TODO(verify: OSH Park) drilled vs finished; moot for the 0.3 mm via.
(rule "fab_hole_size"
  (constraint hole_size (min 0.254mm)))

# Annular ring. [OSH] 4 mil (0.1016 mm).
(rule "fab_annular_ring"
  (constraint annular_width (min 0.1016mm)))

# Via pad diameter: min drill 0.254 + 2 x 0.1016 ring = 0.4572 mm.
(rule "fab_via_diameter"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.4572mm)))

# Hole-to-hole, edge to edge. [OSH] no minimum; 5 mil (0.127 mm) recommended.
(rule "fab_hole_to_hole"
  (constraint hole_to_hole (min 0.127mm)))

# Plated hole to inner-layer copper. [OSH] 10 mil (0.254 mm).
(rule "fab_hole_to_inner_copper"
  (layer inner)
  (constraint hole_clearance (min 0.254mm)))

# Silkscreen text. [OSH] states no text height. The 0.8 / 0.15 mm values are kept as a house rule
# (designer's call per the 2026-11-12 decision record; not an OSH Park limit).
(rule "fab_silk_text"
  (layer "?.Silkscreen")
  (constraint text_height (min 0.8mm))
  (constraint text_thickness (min 0.15mm)))

# Board-setup values (apply_board_setup.py and the OSH-only overrides): mask web 0.1016 mm [OSH] 4 mil;
# mask expansion 0.0508 mm TODO(verify); board 1.6 mm; copper 1 oz outer / 0.5 oz inner.
