\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Validation-sweep summary, \texttt  {TP0014}--\texttt  {TP0038} (firmware v3). Left: hold-window tracking error remains unbiased at every setpoint; the three inflated $\sigma $ bars are the residual failure runs. Center: hysteretic dropout-event count --- only 0.12, 0.15, and 0.87 cycle; the deep out-of-band endpoints 0 and 1 are clean latched cutoffs. Right: run-minimum bus voltage; only \texttt  {TP0016} (0.15) collapses the bus.}}{11}{figure.caption.13}\protected@file@percent }
\newlabel{fig:valsummary}{{8}{11}{Validation-sweep summary, \code {TP0014}--\code {TP0038} (firmware v3). Left: hold-window tracking error remains unbiased at every setpoint; the three inflated $\sigma $ bars are the residual failure runs. Center: hysteretic dropout-event count --- only 0.12, 0.15, and 0.87 cycle; the deep out-of-band endpoints 0 and 1 are clean latched cutoffs. Right: run-minimum bus voltage; only \code {TP0016} (0.15) collapses the bus}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \texttt  {WP0040} (moving setpoint and load): measured share (orange) against the raw table setpoint (dashed) and the governed setpoint reconstructed from the firmware's clip law (mustard). The measured share follows the governed command everywhere the share is measurable; the flat 0.5 stretches at $t=25$--33\,s are the designed collapse below $2I_\mathrm  {min}$ of filtered total current, not tracking failure.}}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:wp0040}{{9}{12}{\code {WP0040} (moving setpoint and load): measured share (orange) against the raw table setpoint (dashed) and the governed setpoint reconstructed from the firmware's clip law (mustard). The measured share follows the governed command everywhere the share is measurable; the flat 0.5 stretches at $t=25$--33\,s are the designed collapse below $2I_\mathrm {min}$ of filtered total current, not tracking failure}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Residual failure at the in-band boundary: \texttt  {TP0016}, $r^\ast =0.15$}{12}{subsection.5.3}\protected@file@percent }
\newlabel{sec:tp0016}{{5.3}{12}{Residual failure at the in-band boundary: \code {TP0016}, $r^\ast =0.15$}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \texttt  {TP0016} ($r^\ast =0.15$) ramp-down window. The limit cycle survives at the in-band boundary: mutually exclusive conduction with reconnect spikes to 2.4\,A (top), bus collapse deepening to 8.2\,V as commanded current falls (middle), and the droop-gain commands cycling in antiphase --- now confined to 0.2--0.65 by the slew limiter rather than slamming rail-to-rail as in fw~0 (bottom).}}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:tp0016}{{10}{13}{\code {TP0016} ($r^\ast =0.15$) ramp-down window. The limit cycle survives at the in-band boundary: mutually exclusive conduction with reconnect spikes to 2.4\,A (top), bus collapse deepening to 8.2\,V as commanded current falls (middle), and the droop-gain commands cycling in antiphase --- now confined to 0.2--0.65 by the slew limiter rather than slamming rail-to-rail as in fw~0 (bottom)}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}The ungoverned setpoint window: \texttt  {TP0037}, $r^\ast =0.87$}{13}{subsection.5.4}\protected@file@percent }
\newlabel{sec:gap}{{5.4}{13}{The ungoverned setpoint window: \code {TP0037}, $r^\ast =0.87$}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \texttt  {TP0037} ($r^\ast =0.87$) during the 6\,A hold: the unmitigated limit cycle in the ungoverned window. The BT channel duty-cycles at 19.5\,Hz (top), the filtered share saws around the setpoint (middle), and the commanded droop ratio sawtooths between 0.45 and 0.79 --- never reaching the 0.85 cutoff threshold (dashed, bottom), so neither mitigation path ever engages.}}{15}{figure.caption.16}\protected@file@percent }
\newlabel{fig:tp0037}{{11}{15}{\code {TP0037} ($r^\ast =0.87$) during the 6\,A hold: the unmitigated limit cycle in the ungoverned window. The BT channel duty-cycles at 19.5\,Hz (top), the filtered share saws around the setpoint (middle), and the commanded droop ratio sawtooths between 0.45 and 0.79 --- never reaching the 0.85 cutoff threshold (dashed, bottom), so neither mitigation path ever engages}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}\texttt  {WP0039}: a brownout-terminated total-dropout ratchet}{15}{subsection.5.5}\protected@file@percent }
\newlabel{sec:wp0039}{{5.5}{15}{\code {WP0039}: a brownout-terminated total-dropout ratchet}{subsection.5.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \texttt  {WP0039} final 3\,s. Top: both channels drop out together and alternate 1.4--3.2\,A reconnect spikes at 34\,Hz. Bottom: the sag floor ratchets monotonically from 13.9\,V to 7.6\,V, then the bus free-falls and the log truncates mid-decay (no trailer) --- consistent with an MCU brownout. \texttt  {fault\_flags} remained zero throughout.}}{16}{figure.caption.17}\protected@file@percent }
\newlabel{fig:wp0039}{{12}{16}{\code {WP0039} final 3\,s. Top: both channels drop out together and alternate 1.4--3.2\,A reconnect spikes at 34\,Hz. Bottom: the sag floor ratchets monotonically from 13.9\,V to 7.6\,V, then the bus free-falls and the log truncates mid-decay (no trailer) --- consistent with an MCU brownout. \code {fault\_flags} remained zero throughout}{figure.caption.17}{}}
