\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Capture 12 (2026-08-11): \texttt  {TP0010}-condition repeat, 20\,ms/div. CH1 VBUS (yellow, 5\,V/div) and CH3 V-MOT (blue, 5\,V/div) overlap and sag together in $\approx $3--4\,V sawtooth ramps at a 67.6\,ms period (cursors); CH2 battery INA (purple, 1\,A/div) shows the dropout--reconnect-spike--conduction pattern synchronized with the voltage recoveries. The flat yellow line near 15.9\,V is the Y1 measurement cursor, not the VBUS trace.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cap12}{{6}{9}{Capture 12 (2026-08-11): \code {TP0010}-condition repeat, 20\,ms/div. CH1 VBUS (yellow, 5\,V/div) and CH3 V-MOT (blue, 5\,V/div) overlap and sag together in $\approx $3--4\,V sawtooth ramps at a 67.6\,ms period (cursors); CH2 battery INA (purple, 1\,A/div) shows the dropout--reconnect-spike--conduction pattern synchronized with the voltage recoveries. The flat yellow line near 15.9\,V is the Y1 measurement cursor, not the VBUS trace}{figure.caption.7}{}}
