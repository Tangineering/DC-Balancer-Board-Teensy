\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Mitigation set and sweep design}{17}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}The firmware v3 failure points are closed}{17}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Firmware~v4 ladder summary, \texttt  {TP0041}--\texttt  {TP0068}. Left: hold-window tracking error of the governed (in-band, completed) runs; the non-zero means at 0.15--0.20 and 0.83--0.85 are the raised governor floor clipping at hold, not loop error. Center: hysteretic dropout events --- zero everywhere, including the six faulted runs, whose relay cycle never co-conducts and is therefore invisible to a minority-dropout counter. Right: run-minimum bus voltage; crosses mark the six \texttt  {ERR\_UV\_BUS} latches, and \texttt  {TP0060} is the surviving near-miss at 12.9\,V.}}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:v4summary}{{13}{18}{Firmware~v4 ladder summary, \code {TP0041}--\code {TP0068}. Left: hold-window tracking error of the governed (in-band, completed) runs; the non-zero means at 0.15--0.20 and 0.83--0.85 are the raised governor floor clipping at hold, not loop error. Center: hysteretic dropout events --- zero everywhere, including the six faulted runs, whose relay cycle never co-conducts and is therefore invisible to a minority-dropout counter. Right: run-minimum bus voltage; crosses mark the six \code {ERR\_UV\_BUS} latches, and \code {TP0060} is the surviving near-miss at 12.9\,V}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}A new failure mode: the source-commutation relay cycle}{18}{subsection.6.3}\protected@file@percent }
\newlabel{sec:relay}{{6.3}{18}{A new failure mode: the source-commutation relay cycle}{subsection.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The six \texttt  {ERR\_UV\_BUS} runs. ``Relay onset'' is the first exclusive-conduction handoff; ``first $<$12\,V'' is the first bus sample under the fault limit; ``latch delay'' is from that sample to the end of the log.}}{18}{table.caption.22}\protected@file@percent }
\newlabel{tab:v4faults}{{2}{18}{The six \code {ERR\_UV\_BUS} runs. ``Relay onset'' is the first exclusive-conduction handoff; ``first $<$12\,V'' is the first bus sample under the fault limit; ``latch delay'' is from that sample to the end of the log}{table.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \texttt  {TP0053} ($r^\ast =0.70$): the source-commutation relay cycle. Top: FC and BT alternate exclusive conduction with 2--3\,A reconnect bursts; co-conduction never occurs. Middle: each both-channels-off handoff window discharges the motor node, and the troughs walk monotonically down through the 12\,V fault limit as the load ramp steepens the discharge slope. Bottom: the commanded droop ratio sawtooths between reproducible commutation thresholds at the slew-limited rate.}}{19}{figure.caption.23}\protected@file@percent }
\newlabel{fig:tp0053relay}{{14}{19}{\code {TP0053} ($r^\ast =0.70$): the source-commutation relay cycle. Top: FC and BT alternate exclusive conduction with 2--3\,A reconnect bursts; co-conduction never occurs. Middle: each both-channels-off handoff window discharges the motor node, and the troughs walk monotonically down through the 12\,V fault limit as the load ramp steepens the discharge slope. Bottom: the commanded droop ratio sawtooths between reproducible commutation thresholds at the slew-limited rate}{figure.caption.23}{}}
