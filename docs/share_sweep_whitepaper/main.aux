\newlabel{sec:wpv4}{{6.5}{20}{\code {W}-profile boundary: the floor law fails at higher load, and the MCU dies upstream of the bus}{subsection.6.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces The floor-law failure boundary in region R6 of the \texttt  {W} profile (share setpoint steps to $1-b$ at 6\,A command). Top: \texttt  {WP0071} ($b=0.25$, commanded minority 0.399\,A) --- a clean step and steady co-conduction. Bottom: \texttt  {WP0073} ($b=0.22$, commanded minority 0.381\,A) --- an 18.7\,Hz single-channel dropout cycle for the entire region; the log truncates at 18.48\,s.}}{21}{figure.caption.24}\protected@file@percent }
\newlabel{fig:wpboundary}{{15}{21}{The floor-law failure boundary in region R6 of the \code {W} profile (share setpoint steps to $1-b$ at 6\,A command). Top: \code {WP0071} ($b=0.25$, commanded minority 0.399\,A) --- a clean step and steady co-conduction. Bottom: \code {WP0073} ($b=0.22$, commanded minority 0.381\,A) --- an 18.7\,Hz single-channel dropout cycle for the entire region; the log truncates at 18.48\,s}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \texttt  {WP0072} ($b=0.20$), final 1.5\,s before truncation. Top: the battery channel drops and reconnects at 18.7\,Hz while the fuel-cell channel absorbs the full load. Middle: the commanded droop ratio is a slew-rate-limited triangle --- the 0.02-per-tick limit sets the 54\,ms period. Bottom: the bus never leaves regulation (ripple 0.35\,V, minimum 15.51\,V); the MCU brownout that truncates the log is invisible on every logged channel.}}{22}{figure.caption.25}\protected@file@percent }
\newlabel{fig:wp0072cycle}{{16}{22}{\code {WP0072} ($b=0.20$), final 1.5\,s before truncation. Top: the battery channel drops and reconnects at 18.7\,Hz while the fuel-cell channel absorbs the full load. Middle: the commanded droop ratio is a slew-rate-limited triangle --- the 0.02-per-tick limit sets the 54\,ms period. Bottom: the bus never leaves regulation (ripple 0.35\,V, minimum 15.51\,V); the MCU brownout that truncates the log is invisible on every logged channel}{figure.caption.25}{}}
